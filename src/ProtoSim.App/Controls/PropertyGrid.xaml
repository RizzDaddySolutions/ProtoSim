<UserControl x:Class="ProtoSim.App.Controls.PropertyGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl x:Name="Items" Focusable="False">
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsPresenter />
                </ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.GroupStyle>
            <GroupStyle>
                <GroupStyle.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" Margin="0,14,0,6" />
                    </DataTemplate>
                </GroupStyle.HeaderTemplate>
            </GroupStyle>
        </ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,3" ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="300">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding LabelWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox Grid.Column="1" MinHeight="32"
                             Text="{Binding Text, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True}"
                             Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding Value}" VerticalAlignment="Center"
                              Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding EnumValues}" SelectedItem="{Binding Value}" MinHeight="32"
                              Visibility="{Binding IsEnum, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
