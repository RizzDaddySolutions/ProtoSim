<Window x:Class="ProtoSim.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProtoSim.App.ViewModels"
        xmlns:views="clr-namespace:ProtoSim.App.Views"
        Title="{Binding Title}" Width="1440" Height="900" MinWidth="980" MinHeight="600"
        Background="{DynamicResource ApplicationWindowBackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="F5" Command="{Binding StartAllCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding StopAllCommand}" />
        <KeyBinding Key="F1" Command="{Binding HelpCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ShowLogicCommand}" />
        <KeyBinding Key="L" Modifiers="Control+Shift" Command="{Binding ToggleLogicDockCommand}" />
        <KeyBinding Key="W" Modifiers="Control+Shift" Command="{Binding NetworkWizardCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleLeftPanelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
            <views:DeviceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogicViewModel}">
            <views:LogicView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientViewModel}">
            <views:ClientView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LinkViewModel}">
            <views:LinkView />
        </DataTemplate>

        <Style x:Key="PluginMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding DisplayName}" />
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="ToolTip" Value="{Binding Description}" />
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_New project" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _as…" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Simulation">
                <MenuItem Header="Add _device" ItemsSource="{Binding AddDeviceActions}" ItemContainerStyle="{StaticResource PluginMenuItem}" />
                <MenuItem Header="Add _client" ItemsSource="{Binding AddClientActions}" ItemContainerStyle="{StaticResource PluginMenuItem}"
                          ToolTip="Connect to an external server or device and pull its data into project tags" />
                <MenuItem Header="D_uplicate device" Command="{Binding DuplicateSelectedCommand}" />
                <MenuItem Header="_Remove selected" Command="{Binding RemoveSelectedCommand}" />
                <Separator />
                <MenuItem Header="_Start all devices" Command="{Binding StartAllCommand}" InputGestureText="F5" />
                <MenuItem Header="S_top all devices" Command="{Binding StopAllCommand}" InputGestureText="Shift+F5" />
            </MenuItem>
            <MenuItem Header="_Logic">
                <MenuItem Header="Logic _designer" Command="{Binding ShowLogicCommand}" InputGestureText="Ctrl+L"
                          ToolTip="Function block programs that combine tags from different devices" />
                <MenuItem Header="_Undock designer" IsCheckable="True" IsChecked="{Binding Logic.IsUndocked, Mode=OneWay}"
                          Command="{Binding ToggleLogicDockCommand}" InputGestureText="Ctrl+Shift+L"
                          ToolTip="Open the designer in a window of its own instead of inside the main window" />
            </MenuItem>
            <MenuItem Header="_Network">
                <MenuItem Header="Network _wizard…" Command="{Binding NetworkWizardCommand}" InputGestureText="Ctrl+Shift+W"
                          ToolTip="Connect simulators on this computer or on other computers into a simulation network" />
                <Separator />
                <MenuItem Header="_Start all links" Command="{Binding StartAllLinksCommand}" />
                <MenuItem Header="S_top all links" Command="{Binding StopAllLinksCommand}" />
                <Separator />
                <MenuItem Header="Share devices on the _network" IsCheckable="True" IsChecked="{Binding ShareOnNetwork}"
                          ToolTip="{Binding SharingStatus}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Clients panel" IsCheckable="True" IsChecked="{Binding ShowClientsPanel}"
                          ToolTip="Show the Clients list in the left panel" />
                <MenuItem Header="_Network links panel" IsCheckable="True" IsChecked="{Binding ShowLinksPanel}"
                          ToolTip="Show the Network links list in the left panel" />
                <Separator />
                <MenuItem Header="Theme: _System" IsCheckable="True" IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="System" />
                <MenuItem Header="Theme: _Light" IsCheckable="True" IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                <MenuItem Header="Theme: _Dark" IsCheckable="True" IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                          Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_View help" Command="{Binding HelpCommand}" InputGestureText="F1" />
                <Separator />
                <MenuItem Header="_About ProtoSim" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Padding="8,4" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ToggleButton IsChecked="{Binding SimulationEnabled, UpdateSourceTrigger=PropertyChanged}"
                          Height="32" Padding="10,5" HorizontalAlignment="Left" VerticalContentAlignment="Center"
                          ToolTip="Enable or disable simulated tag values">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Text" Value="&#xE768;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SimulationEnabled}" Value="True">
                                        <Setter Property="Text" Value="&#xE71A;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Enable Simulation" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SimulationEnabled}" Value="True">
                                        <Setter Property="Text" Value="Disable Simulation" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ToggleButton>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="12,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="290" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Grid Grid.Row="0" Margin="12,12,6,12" Visibility="{Binding LeftPanelExpanded, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ClientsRow" Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="LinksRow" Height="2*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Margin="4,0,0,6">
                    <Menu DockPanel.Dock="Right" Background="Transparent">
                        <MenuItem ToolTip="Add a simulated device" ItemsSource="{Binding AddDeviceActions}" ItemContainerStyle="{StaticResource PluginMenuItem}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                    <TextBlock Text="Add" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </Menu>
                    <TextBlock Text="SIMULATED DEVICES" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                </DockPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                         Background="{DynamicResource ApplicationPanelBackgroundBrush}"
                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                         Margin="0,0,10,0" ToolTip="{Binding StatusText}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="{Binding ProtocolName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Endpoint, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Row="2" Margin="4,14,0,6" Visibility="{Binding ShowClientsPanel, Converter={StaticResource BoolToVisibility}}">
                    <Menu DockPanel.Dock="Right" Background="Transparent">
                        <MenuItem ToolTip="Add a client that connects to an external server or device" ItemsSource="{Binding AddClientActions}" ItemContainerStyle="{StaticResource PluginMenuItem}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                    <TextBlock Text="Add" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </Menu>
                    <TextBlock Text="CLIENTS" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                </DockPanel>

                <ListBox Grid.Row="3" ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                         Visibility="{Binding ShowClientsPanel, Converter={StaticResource BoolToVisibility}}"
                         Background="{DynamicResource ApplicationPanelBackgroundBrush}"
                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ClientViewModel}">
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                         Margin="0,0,10,0" ToolTip="{Binding LastMessage}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ProtocolName, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding Endpoint, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Row="4" Margin="4,14,0,6" Visibility="{Binding ShowLinksPanel, Converter={StaticResource BoolToVisibility}}">
                    <Button DockPanel.Dock="Right" Command="{Binding NetworkWizardCommand}" Style="{StaticResource ToolbarButton}"
                            ToolTip="Connect a simulator here or on another computer (Ctrl+Shift+W)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                            <TextBlock Text="Wizard" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="NETWORK LINKS" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                </DockPanel>

                <ListBox Grid.Row="5" ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink}"
                         Visibility="{Binding ShowLinksPanel, Converter={StaticResource BoolToVisibility}}"
                         Background="{DynamicResource ApplicationPanelBackgroundBrush}"
                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LinkViewModel}">
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                         Margin="0,0,10,0" ToolTip="{Binding Link.LastMessage}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceDescription}">
                                        <Run Text="{Binding ProtocolName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="6" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding StartAllCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Start all devices (F5)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="Start all" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopAllCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Stop all devices (Shift+F5)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="Stop all" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RemoveSelectedCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Remove the selected device, client or network link">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <GridSplitter x:Name="NavSplitter" Grid.Row="0" Grid.Column="1" Width="5" DragCompleted="OnNavSplitterDragCompleted"
                          Visibility="{Binding LeftPanelExpanded, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- Show/hide tab in the middle of the divider -->
            <Button Grid.Row="0" Grid.Column="1" Command="{Binding ToggleLeftPanelCommand}" Width="16" Height="48" Padding="0"
                    MinWidth="0" MinHeight="0" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="ToolTip" Value="Hide the left panel (Ctrl+B)" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LeftPanelCollapsed}" Value="True">
                                <Setter Property="ToolTip" Value="Show the left panel (Ctrl+B)" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Text" Value="&#xE76B;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LeftPanelCollapsed}" Value="True">
                                    <Setter Property="Text" Value="&#xE76C;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>

            <!-- Content -->
            <ContentControl Grid.Row="0" Grid.Column="2" Content="{Binding Selected}" Margin="6,12,12,12" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Padding="32">
                                                <StackPanel>
                                                    <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Left" Margin="0,0,0,12"
                                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <TextBlock Text="ProtoSim" Style="{StaticResource PageTitle}" />
                                                     <TextBlock TextWrapping="Wrap" Margin="0,8,0,20" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="Simulate industrial devices that real protocol clients (SCADA, HMI, PLC programs) can connect to, pull data in from external servers and devices with clients, and connect simulators on this and other computers into a network with the network wizard. Add a device from the left panel to get started." />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Open project…" Padding="16,8"
                                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
        </DockPanel>

        <Border Grid.RowSpan="2" Background="#88000000" Visibility="{Binding IsLoadingProject, Converter={StaticResource BoolToVisibility}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="28,22">
                <StackPanel>
                    <Grid Width="42" Height="42" HorizontalAlignment="Center">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="ProjectLoadingRotation" CenterX="21" CenterY="21" />
                        </Grid.RenderTransform>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="ProjectLoadingRotation" Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Loading project…" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
