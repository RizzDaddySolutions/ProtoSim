<UserControl x:Class="ProtoSim.App.Views.LinkView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ProtoSim.App.Views"
             xmlns:controls="clr-namespace:ProtoSim.App.Controls">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBox Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"
                         BorderThickness="0" Background="Transparent" Padding="0" HorizontalAlignment="Left" MinWidth="200"
                         ToolTip.Tip="Click to rename" />
                <TextBlock Classes="caption" Margin="0,2,0,0">
                    <Run Text="Network link · " /><Run Text="{Binding ProtocolName, Mode=OneWay}" /><Run Text=" from " /><Run Text="{Binding SourceDescription, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Endpoint, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding StartCommand}" Classes="accent" Padding="14,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{StaticResource IconPlay}" Margin="0,0,6,0" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopCommand}" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <PathIcon Data="{StaticResource IconStop}" Margin="0,0,6,0" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: connection and timing -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <Border Classes="card" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CONNECTION" Classes="sectionHeader" />
                            <TextBlock Text="Stop the link to change connection settings." Classes="caption" Margin="0,4,0,0"
                                       IsVisible="{Binding !CanEditSettings}" />
                            <controls:PropertyGrid SelectedObject="{Binding Settings}" IsEnabled="{Binding CanEditSettings}" LabelWidth="140" />
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Text="TIMING" Classes="sectionHeader" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Poll every" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding Link.PollIntervalMs, UpdateSourceTrigger=LostFocus}" Width="90" />
                                <TextBlock Text="ms" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <CheckBox Content="Start the link when the project opens" IsChecked="{Binding Link.AutoStart}" Margin="0,8,0,0" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Each cycle reads every point from the source and copies it into its tag. Read-only points pause the tag's own simulation while the link runs. For Read + write points, a change made here (by a client, logic or simulation) is written back to the source instead." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- Right: status, points, traffic -->
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="110" />
                </Grid.RowDefinitions>

                <Border Classes="card" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Classes="statusDot" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Link.LastMessage}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Link.LastMessage}" />
                        <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center">
                            <Run Text="{Binding Link.LastElapsed, Mode=OneWay}" /><Run Text="  ·  cycles " /><Run Text="{Binding Link.Cycles, Mode=OneWay}" /><Run Text="  ·  failed " /><Run Text="{Binding Link.Failures, Mode=OneWay}" /><Run Text="  ·  written back " /><Run Text="{Binding Link.Writes, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="1" Margin="0,4,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="All read only" Command="{Binding ReadAllCommand}" Classes="toolbar" />
                        <Button Content="All read + write" Command="{Binding ReadWriteAllCommand}" Classes="toolbar"
                                ToolTip.Tip="Write changes made here back to the source (the source tags must be Writeable)" />
                        <Button Command="{Binding AddPointCommand}" Classes="toolbar">
                            <StackPanel Orientation="Horizontal">
                                <PathIcon Data="{StaticResource IconAdd}" Margin="0,0,6,0" />
                                <TextBlock Text="Add point" />
                            </StackPanel>
                        </Button>
                        <Button Content="Remove" Command="{Binding RemovePointCommand}" Classes="toolbar" />
                    </StackPanel>
                    <TextBlock Text="POINTS" Classes="sectionHeader" VerticalAlignment="Center" />
                </DockPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Link.Points}" SelectedItem="{Binding SelectedPoint}"
                         >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source tag" Binding="{Binding SourceName}" Width="130" />
                        <DataGridTextColumn Header="Source address" Binding="{Binding Source, UpdateSourceTrigger=LostFocus}" CellStyleClasses="mono" Width="150" />
                        <DataGridTemplateColumn Header="Type" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><ComboBox Classes="grid" ItemsSource="{x:Static views:LinkView.DataTypes}" SelectedItem="{Binding DataType, Mode=TwoWay}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Direction" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Direction}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedItem="{Binding Direction}"
                                              ItemsSource="{Binding DataContext.Directions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Project tag (Device/Tag)" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Target}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <AutoCompleteBox FilterMode="Contains" Text="{Binding Target, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding DataContext.TagReferences, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=OneWay}" CellStyleClasses="mono" IsReadOnly="True" Width="90" />
                        <DataGridTemplateColumn Header="Status" Width="150" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" ToolTip.Tip="{Binding Status}" Classes.error="{Binding HasError}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Margin="0,4" />

                <views:LogView Grid.Row="4" DataContext="{Binding Log}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
