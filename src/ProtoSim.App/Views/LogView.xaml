<UserControl x:Class="ProtoSim.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" VerticalAlignment="Center">
            <ToggleButton IsChecked="{Binding IsPaused}" Padding="10,5" Margin="0,0,6,0" ToolTip="Pause the display (traffic keeps being captured)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="Pause" />
                </StackPanel>
            </ToggleButton>
            <Button Command="{Binding ClearCommand}" Style="{StaticResource ToolbarButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE894;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportCommand}" Style="{StaticResource ToolbarButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="Export" />
                </StackPanel>
            </Button>
            <CheckBox Content="Capture" IsChecked="{Binding IsCapturing}" Margin="8,0" VerticalAlignment="Center" ToolTip="Turn off to stop recording traffic (saves CPU under heavy load)" />
            <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}" Margin="8,0" VerticalAlignment="Center" />
            <CheckBox Content="Frames" IsChecked="{Binding ShowFrames}" Margin="8,0" VerticalAlignment="Center" />
            <CheckBox Content="Events" IsChecked="{Binding ShowEvents}" Margin="8,0" VerticalAlignment="Center" />
            <TextBlock Text="Filter" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Width="220" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="Matches summary, remote address or hex bytes" />
        </WrapPanel>

        <DataGrid x:Name="Grid" ItemsSource="{Binding View}" IsReadOnly="True" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" ElementStyle="{StaticResource MonoCell}" Width="100" />
                <DataGridTemplateColumn Header="Type" Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DirectionText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{Binding Direction, Converter={StaticResource DirectionToBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="150" />
                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="2*" />
                <DataGridTextColumn Header="Bytes" Binding="{Binding Hex}" ElementStyle="{StaticResource MonoCell}" Width="1.5*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
