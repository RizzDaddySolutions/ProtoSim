<Window x:Class="ProtoSim.App.Views.ImportTagsDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import tags" Width="500" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
        <DockPanel Margin="24,20,24,20">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <PathIcon Data="{StaticResource IconImport}" Width="22" Height="22" Margin="0,0,10,0"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="Import tags from CSV" Classes="pageTitle" FontSize="20" />
            </StackPanel>
            <TextBlock Classes="caption" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None">
                <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ImportCount, Mode=OneWay}" /><Run Text=" tags found" />
            </TextBlock>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Import" IsDefault="True" Classes="accent" Padding="20,6" MinWidth="96"
                    Margin="0,0,8,0" Click="OnImport" />
            <Button Content="Cancel" IsCancel="True" Padding="20,6" MinWidth="96" Click="OnCancel" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="WHAT SHOULD HAPPEN TO THE EXISTING TAGS?" Classes="sectionHeader" Margin="0,0,0,8" />

            <Border Classes="card" Padding="14,12" Margin="0,0,0,8">
                <RadioButton x:Name="AppendOption" GroupName="Mode" IsChecked="True" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Append" FontWeight="SemiBold" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0">
                            <Run Text="Keep the" /> <Run Text="{Binding ExistingCount, Mode=OneWay}" /> <Run Text="existing tags and add the imported tags after them." />
                        </TextBlock>
                    </StackPanel>
                </RadioButton>
            </Border>

            <Border Classes="card" Padding="14,12" Margin="0,0,0,8">
                <RadioButton x:Name="OverwriteOption" GroupName="Mode" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Overwrite" FontWeight="SemiBold" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0">
                            <Run Text="Remove all" /> <Run Text="{Binding ExistingCount, Mode=OneWay}" /> <Run Text="existing tags and replace them with the imported tags." />
                        </TextBlock>
                    </StackPanel>
                </RadioButton>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
