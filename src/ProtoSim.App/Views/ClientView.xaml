<UserControl x:Class="ProtoSim.App.Views.ClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ProtoSim.App.Views"
             xmlns:controls="clr-namespace:ProtoSim.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="22" FontWeight="SemiBold"
                         BorderThickness="0" Background="Transparent" Padding="0" HorizontalAlignment="Left" MinWidth="200"
                         ToolTip="Click to rename" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                    <Run Text="{Binding ProtocolName, Mode=OneWay}" /><Run Text=" client → " /><Run Text="{Binding Endpoint, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ConnectCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE703;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Connect" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DisconnectCommand}" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Disconnect" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: connection + request -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CONNECTION" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="Disconnect to change connection settings." Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding CanEditSettings, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <controls:PropertyGrid SelectedObject="{Binding Settings}" IsEnabled="{Binding CanEditSettings}" LabelWidth="150" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="REQUEST" Style="{StaticResource SectionHeader}" />
                            <controls:PropertyGrid SelectedObject="{Binding Request}" LabelWidth="150" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Command="{Binding ExecuteCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE724;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                        <TextBlock Text="Send once" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StartPollingCommand}" Padding="12,6" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                        <TextBlock Text="Poll" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StopPollingCommand}" Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                        <TextBlock Text="Stop" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Poll every" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding PollIntervalMs, UpdateSourceTrigger=LostFocus}" Width="90" />
                                <TextBlock Text="ms" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <CheckBox Content="Start polling when the project opens" IsChecked="{Binding AutoPoll}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- Right: results, tag mapping, traffic -->
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="110" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="110" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="110" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding LastMessage}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding LastMessage}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <Run Text="{Binding LastElapsed, Mode=OneWay}" /><Run Text="  ·  OK " /><Run Text="{Binding SuccessCount, Mode=OneWay}" /><Run Text="  ·  failed " /><Run Text="{Binding FailureCount, Mode=OneWay}" />
                            <Hyperlink Command="{Binding ResetCountersCommand}">reset</Hyperlink>
                        </TextBlock>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" ElementStyle="{StaticResource MonoCell}" Width="240" />
                        <DataGridTextColumn Header="Raw" Binding="{Binding Raw}" ElementStyle="{StaticResource MonoCell}" Width="260" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" ElementStyle="{StaticResource MonoCell}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Tag mapping -->
                <DockPanel Grid.Row="2" Margin="0,10,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding MapSelectedRowCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Add a mapping for the selected result row">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="Map selected row" />
                            </StackPanel>
                        </Button>
                        <Button Content="Map all rows" Command="{Binding MapAllRowsCommand}" Style="{StaticResource ToolbarButton}"
                                ToolTip="Add a mapping for every row of the last result that isn't mapped yet" />
                        <Button Content="Add" Command="{Binding AddMappingCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Remove" Command="{Binding RemoveMappingCommand}" Style="{StaticResource ToolbarButton}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="COPY INTO TAGS" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="After every successful request, each mapped row's value is written to a project tag, so simulated servers and logic programs can use it. Mapped tags pause their own simulation while polling." />
                    </StackPanel>
                </DockPanel>
                <DataGrid Grid.Row="3" ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}"
                          CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Result row" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource MonoCell}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True" Text="{Binding Source, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding DataContext.SourceOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Project tag (Device/Tag)" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Target}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True" IsTextSearchEnabled="True" Text="{Binding Target, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding DataContext.TagReferences, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Last copy" Width="*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                        <Setter Property="Foreground" Value="#D83B3B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Margin="0,4" />

                <views:LogView Grid.Row="5" DataContext="{Binding Log}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
