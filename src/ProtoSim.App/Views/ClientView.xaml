<UserControl x:Class="ProtoSim.App.Views.ClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ProtoSim.App.Views"
             xmlns:controls="clr-namespace:ProtoSim.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="22" FontWeight="SemiBold"
                         BorderThickness="0" Background="Transparent" Padding="0" HorizontalAlignment="Left" MinWidth="200" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                    <Run Text="{Binding ProtocolName, Mode=OneWay}" /><Run Text=" client → " /><Run Text="{Binding Endpoint, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ConnectCommand}" Style="{StaticResource ToolbarButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE703;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Connect" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DisconnectCommand}" Style="{StaticResource ToolbarButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Disconnect" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: connection + request -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CONNECTION" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="Disconnect to change connection settings." Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding CanEditSettings, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <controls:PropertyGrid SelectedObject="{Binding Settings}" IsEnabled="{Binding CanEditSettings}" LabelWidth="150" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="REQUEST" Style="{StaticResource SectionHeader}" />
                            <controls:PropertyGrid SelectedObject="{Binding Request}" LabelWidth="150" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Command="{Binding ExecuteCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE724;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                        <TextBlock Text="Send once" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StartPollingCommand}" Padding="12,6" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                        <TextBlock Text="Poll" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StopPollingCommand}" Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                        <TextBlock Text="Stop" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Poll every" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding PollIntervalMs, UpdateSourceTrigger=LostFocus}" Width="90" />
                                <TextBlock Text="ms" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- Right: results + traffic -->
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding LastSuccess, Converter={StaticResource StateToBrush}}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding LastMessage}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding LastMessage}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <Run Text="{Binding LastElapsed, Mode=OneWay}" /><Run Text="  ·  OK " /><Run Text="{Binding SuccessCount, Mode=OneWay}" /><Run Text="  ·  failed " /><Run Text="{Binding FailureCount, Mode=OneWay}" />
                            <Hyperlink Command="{Binding ResetCountersCommand}">reset</Hyperlink>
                        </TextBlock>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" ElementStyle="{StaticResource MonoCell}" Width="240" />
                        <!-- Raw: register hex for Modbus, NodeId/status for OPC UA -->
                        <DataGridTextColumn Header="Raw / Node" Binding="{Binding Raw}" ElementStyle="{StaticResource MonoCell}" Width="300" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" ElementStyle="{StaticResource MonoCell}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Margin="0,4" />

                <views:LogView Grid.Row="3" DataContext="{Binding Log}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
