<Window x:Class="ProtoSim.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" MinHeight="180" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24,20,24,20">
        <!-- Buttons (filled in code so each MessageBoxButton set gets the right labels and defaults) -->
        <StackPanel x:Name="ButtonPanel" DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="28" VerticalAlignment="Top"
                       Margin="0,2,16,0" Visibility="Collapsed" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" FontSize="18" TextWrapping="Wrap" />
                <!-- Read-only TextBox so error details can be selected and copied. -->
                <TextBox x:Name="MessageText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0"
                         Background="Transparent" Margin="0,8,0,0" MaxHeight="360"
                         VerticalScrollBarVisibility="Auto" Focusable="False"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
