<UserControl x:Class="ProtoSim.App.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProtoSim.App.ViewModels"
             xmlns:views="clr-namespace:ProtoSim.App.Views"
             xmlns:controls="clr-namespace:ProtoSim.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="22" FontWeight="SemiBold"
                         BorderThickness="0" Background="Transparent" Padding="0" HorizontalAlignment="Left" MinWidth="200"
                         ToolTip="Click to rename" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                    <Run Text="{Binding ProtocolName, Mode=OneWay}" /><Run Text=" server · " /><Run Text="{Binding Endpoint, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="12" Padding="10,4" Margin="0,0,12,0" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" MaxWidth="420">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                    </StackPanel>
                </Border>
                <Button Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopCommand}" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Raw data -->
            <TabItem Header="Data" Visibility="{Binding HasDataAreas, Converter={StaticResource BoolToVisibility}}">
                <DockPanel DataContext="{Binding SelectedArea}" Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding DataContext.Areas, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding DataContext.SelectedArea, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  DisplayMemberPath="Name" Width="190" Margin="0,0,12,4" />
                        <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <TextBox Text="{Binding StartAddress, UpdateSourceTrigger=LostFocus}" Width="80" Margin="0,0,12,4" ToolTip="0-based start offset" />
                        <TextBlock Text="Rows" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <TextBox Text="{Binding RowCount, UpdateSourceTrigger=LostFocus}" Width="70" Margin="0,0,12,4" />
                        <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Previous page" Margin="0,0,4,4">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" />
                        </Button>
                        <Button Command="{Binding NextPageCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Next page" Margin="0,0,12,4">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" />
                        </Button>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsWord, Converter={StaticResource BoolToVisibility}}" Margin="0,0,12,4">
                            <TextBlock Text="Format" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{x:Static vm:AreaViewModel.Formats}" SelectedItem="{Binding Format}" Width="120" />
                        </StackPanel>
                        <TextBlock Text="{Binding RangeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,4" />
                    </WrapPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Visible rows:" VerticalAlignment="Center" Margin="0,0,8,4" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding FillValue, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,6,4" />
                        <Button Content="Fill" Command="{Binding FillCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,6,4" />
                        <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,6,4" />
                        <Button Content="Randomize" Command="{Binding RandomizeCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,6,4" />
                        <Button Content="Sequence 0,1,2…" Command="{Binding IncrementCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,6,4" />
                    </WrapPanel>

                    <Grid>
                        <DataGrid x:Name="WordGrid" ItemsSource="{Binding Rows}" RowStyle="{StaticResource ChangedRow}"
                                  Visibility="{Binding IsWord, Converter={StaticResource BoolToVisibility}}"
                                  PreparingCellForEdit="OnPreparingCellForEdit" CellEditEnding="OnCellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address, Mode=OneWay}" IsReadOnly="True" ElementStyle="{StaticResource MonoCell}" Width="110" />
                                <DataGridTextColumn Header="Offset" Binding="{Binding Index, Mode=OneWay}" IsReadOnly="True" ElementStyle="{StaticResource MonoCell}" Width="90" />
                                <DataGridTextColumn Header="Value (double-click to edit)" Binding="{Binding ValueText}" ElementStyle="{StaticResource MonoCell}" Width="260" />
                                <DataGridTextColumn Header="" Binding="{Binding Error, Mode=OneWay}" IsReadOnly="True" Foreground="#D83B3B" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid ItemsSource="{Binding Rows}" RowStyle="{StaticResource ChangedRow}"
                                  Visibility="{Binding IsBit, Converter={StaticResource BoolToVisibility}}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address, Mode=OneWay}" ElementStyle="{StaticResource MonoCell}" Width="110" />
                                <DataGridTextColumn Header="Offset" Binding="{Binding Index, Mode=OneWay}" ElementStyle="{StaticResource MonoCell}" Width="90" />
                                <DataGridTemplateColumn Header="Value" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding BitValue, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" MinWidth="0" />
                                                <TextBlock Text="{Binding ValueText}" Style="{StaticResource MonoCell}" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Tags -->
            <TabItem Header="Tags &amp; simulation">
                <DockPanel Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Command="{Binding AddTagCommand}" Style="{StaticResource ToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="Add tag" />
                            </StackPanel>
                        </Button>
                        <Button Content="Duplicate" Command="{Binding DuplicateTagCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Remove" Command="{Binding RemoveTagCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Import CSV…" Command="{Binding ImportTagsCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Export CSV…" Command="{Binding ExportTagsCommand}" Style="{StaticResource ToolbarButton}" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8">
                        <Run Text="Address formats: " /><Run Text="{Binding AddressHelp, Mode=OneWay}" />
                    </TextBlock>

                    <DataGrid x:Name="TagGrid" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}"
                              PreparingCellForEdit="OnPreparingCellForEdit" CellEditEnding="OnCellEditEnding" FrozenColumnCount="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Tag.Name}" Width="150" />
                            <DataGridTextColumn Header="Address" Binding="{Binding Tag.Address}" ElementStyle="{StaticResource MonoCell}" Width="180" />
                            <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Tag.DataType}" ItemsSource="{x:Static vm:EnumLists.DataTypes}" Width="90" />
                            <DataGridComboBoxColumn Header="Order" SelectedItemBinding="{Binding Tag.WordOrder}" ItemsSource="{x:Static vm:EnumLists.WordOrders}" Width="80" />
                            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" ElementStyle="{StaticResource MonoCell}" Width="120" />
                            <DataGridComboBoxColumn Header="Simulation" SelectedItemBinding="{Binding Tag.Simulation.Kind}" ItemsSource="{x:Static vm:EnumLists.SimulationKinds}" Width="115" />
                            <DataGridTextColumn Header="Min" Binding="{Binding Tag.Simulation.Min}" Width="65" />
                            <DataGridTextColumn Header="Max" Binding="{Binding Tag.Simulation.Max}" Width="65" />
                            <DataGridTextColumn Header="Period (s)" Binding="{Binding Tag.Simulation.PeriodSeconds}" Width="80" />
                            <DataGridTextColumn Header="Step" Binding="{Binding Tag.Simulation.Step}" Width="60" />
                            <DataGridTextColumn Header="Every (ms)" Binding="{Binding Tag.Simulation.IntervalMs}" Width="85" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Tag.Description}" Width="160" />
                            <DataGridTemplateColumn Header="Status" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Error}" Foreground="#D83B3B" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Error}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Traffic -->
            <TabItem Header="Traffic">
                <views:LogView DataContext="{Binding Log}" Margin="0,10,0,0" />
            </TabItem>

            <!-- Connections & statistics -->
            <TabItem Header="Connections">
                <DockPanel Margin="0,10,0,0">
                    <ItemsControl DockPanel.Dock="Top" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="MinWidth" Value="150" />
                                <Setter Property="Padding" Value="14,10" />
                            </Style>
                        </ItemsControl.Resources>
                        <Border><StackPanel><TextBlock Text="Active connections" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.ActiveConnections}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Requests / s" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.RequestsPerSecond}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Requests" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.Requests, StringFormat=N0}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Responses" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.Responses, StringFormat=N0}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Exceptions sent" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.Exceptions, StringFormat=N0}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Not answered" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.Dropped, StringFormat=N0}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Malformed frames" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.Malformed, StringFormat=N0}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Bytes in / out" Style="{StaticResource Caption}" />
                            <TextBlock Style="{StaticResource StatValue}"><Run Text="{Binding Stats.BytesIn, Mode=OneWay, StringFormat=N0}" /><Run Text=" / " /><Run Text="{Binding Stats.BytesOut, Mode=OneWay, StringFormat=N0}" /></TextBlock></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Total connections" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.TotalConnections, StringFormat=N0}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                    </ItemsControl>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Reset counters" Command="{Binding ResetStatisticsCommand}" />
                        <TextBlock Text="CONNECTED CLIENTS" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Connections}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50" />
                            <DataGridTextColumn Header="Remote endpoint" Binding="{Binding RemoteEndPoint}" Width="220" />
                            <DataGridTextColumn Header="Connected at" Binding="{Binding ConnectedAt}" Width="120" />
                            <DataGridTextColumn Header="Requests" Binding="{Binding Requests}" Width="100" />
                            <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivity}" Width="130" />
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Disconnect" HorizontalAlignment="Left" Padding="10,2"
                                                Command="{Binding DataContext.DropConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Settings">
                <DockPanel Margin="0,10,0,0" MaxWidth="760" HorizontalAlignment="Left">
                    <StackPanel DockPanel.Dock="Top">
                        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8"
                                Visibility="{Binding CanEditSettings, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock Text="Stop the device to change its settings." />
                        </Border>
                        <CheckBox Content="Start this device automatically when the project is opened" IsChecked="{Binding AutoStart}" Margin="0,0,0,4" />
                    </StackPanel>
                    <controls:PropertyGrid SelectedObject="{Binding Settings}" IsEnabled="{Binding CanEditSettings}" />
                </DockPanel>
            </TabItem>

            <!-- Fault injection -->
            <TabItem Header="Fault injection">
                <DockPanel Margin="0,10,0,0" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,4"
                               Text="Make the device misbehave to test how clients handle slow responses, timeouts, error replies and dropped connections. Changes apply immediately, even while running." />
                    <controls:PropertyGrid SelectedObject="{Binding Faults}" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
