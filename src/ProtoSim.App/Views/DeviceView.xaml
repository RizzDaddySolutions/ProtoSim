<UserControl x:Class="ProtoSim.App.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProtoSim.App.ViewModels"
             xmlns:views="clr-namespace:ProtoSim.App.Views"
             xmlns:controls="clr-namespace:ProtoSim.App.Controls"
             DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <Storyboard x:Key="LoadingSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoadingRotation" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:0.9" />
        </Storyboard>
        <Style x:Key="TagGridComboBoxItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="TagGridComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TagGridComboBoxItem}" />
        </Style>
        <Style x:Key="SimulationGridComboBox" TargetType="ComboBox" BasedOn="{StaticResource TagGridComboBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.Writable}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Simulation parameter cells that don't apply to the row's simulation kind are dimmed and read-only. -->
        <Style x:Key="RangeCell" TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesRange}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Opacity" Value="0.3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WordOrderCell" TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesWordOrder}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Opacity" Value="0.3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PeriodCell" TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesPeriod}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Opacity" Value="0.3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepCell" TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesStep}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Opacity" Value="0.3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IntervalCell" TargetType="DataGridCell" BasedOn="{StaticResource GridCell}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesInterval}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Opacity" Value="0.3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="22" FontWeight="SemiBold"
                         BorderThickness="0" Background="Transparent" Padding="0" HorizontalAlignment="Left" MinWidth="200"
                         ToolTip="Click to rename" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                    <Run Text="{Binding ProtocolName, Mode=OneWay}" /><Run Text=" server · " /><Run Text="{Binding Endpoint, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="12" Padding="10,4" Margin="0,0,12,0" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" MaxWidth="420">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                    </StackPanel>
                </Border>
                <Button Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopCommand}" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Raw data -->
            <TabItem Header="Data" Visibility="{Binding HasDataAreas, Converter={StaticResource BoolToVisibility}}">
                <DockPanel DataContext="{Binding SelectedArea}" Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding DataContext.Areas, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding DataContext.SelectedArea, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  DisplayMemberPath="Name" Width="190" Margin="0,0,12,4" />
                        <TextBlock Text="Start" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <TextBox Text="{Binding StartAddress, UpdateSourceTrigger=LostFocus}" Width="80" Margin="0,0,12,4" ToolTip="0-based start offset" />
                        <TextBlock Text="Rows" VerticalAlignment="Center" Margin="0,0,6,4" />
                        <TextBox Text="{Binding RowCount, UpdateSourceTrigger=LostFocus}" Width="70" Margin="0,0,12,4" />
                        <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Previous page" Margin="0,0,4,4">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" />
                        </Button>
                        <Button Command="{Binding NextPageCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Next page" Margin="0,0,12,4">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" />
                        </Button>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsWord, Converter={StaticResource BoolToVisibility}}" Margin="0,0,12,4">
                            <TextBlock Text="Format" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{x:Static vm:AreaViewModel.Formats}" SelectedItem="{Binding Format}" Width="120" />
                        </StackPanel>
                        <TextBlock Text="{Binding RangeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,0,4" />
                    </WrapPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Visible rows:" VerticalAlignment="Center" Margin="0,0,8,4" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding FillValue, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,6,4" />
                        <Button Content="Fill" Command="{Binding FillCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,6,4" />
                        <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,6,4" />
                        <Button Content="Randomize" Command="{Binding RandomizeCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,6,4" />
                        <Button Content="Sequence 0,1,2…" Command="{Binding IncrementCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,6,4" />
                    </WrapPanel>

                    <Grid>
                        <DataGrid x:Name="WordGrid" ItemsSource="{Binding Rows}" RowStyle="{StaticResource ChangedRow}"
                                  Visibility="{Binding IsWord, Converter={StaticResource BoolToVisibility}}"
                                  PreparingCellForEdit="OnPreparingCellForEdit" CellEditEnding="OnCellEditEnding">
                            <DataGrid.Columns>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address, Mode=OneWay}" IsReadOnly="True" ElementStyle="{StaticResource MonoCell}" Width="Auto" />
                            <DataGridTextColumn Header="Offset" Binding="{Binding Index, Mode=OneWay}" IsReadOnly="True" ElementStyle="{StaticResource MonoCell}" Width="Auto" />
                            <DataGridTextColumn Header="Value (double-click to edit)" Binding="{Binding ValueText}" ElementStyle="{StaticResource MonoCell}" Width="Auto" />
                            <DataGridTextColumn Header="" Binding="{Binding Error, Mode=OneWay}" IsReadOnly="True" Foreground="#D83B3B" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid ItemsSource="{Binding Rows}" RowStyle="{StaticResource ChangedRow}"
                                  Visibility="{Binding IsBit, Converter={StaticResource BoolToVisibility}}" IsReadOnly="True">
                            <DataGrid.Columns>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address, Mode=OneWay}" ElementStyle="{StaticResource MonoCell}" Width="Auto" />
                            <DataGridTextColumn Header="Offset" Binding="{Binding Index, Mode=OneWay}" ElementStyle="{StaticResource MonoCell}" Width="Auto" />
                            <DataGridTemplateColumn Header="Value" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding BitValue, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" MinWidth="0" />
                                                <TextBlock Text="{Binding ValueText}" Style="{StaticResource MonoCell}" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Tags -->
            <TabItem Header="Tags &amp; simulation">
                <DockPanel Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Command="{Binding AddTagCommand}" Style="{StaticResource ToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="Add tag" />
                            </StackPanel>
                        </Button>
                        <Button Content="Duplicate" Command="{Binding DuplicateTagCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Remove" Click="OnRemoveSelectedTags" Style="{StaticResource ToolbarButton}"
                                ToolTip="Remove the selected tags (Delete). Shift+click selects a range, Ctrl+click adds or removes single tags." />
                        <Button Content="Clear all tags…" Click="OnClearAllTags" Style="{StaticResource ToolbarButton}"
                                ToolTip="Remove every tag from this simulator" />
                        <Button Content="Import CSV…" Command="{Binding ImportTagsCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Export CSV…" Command="{Binding ExportTagsCommand}" Style="{StaticResource ToolbarButton}" />
                    </WrapPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" VerticalAlignment="Center">
                        <Button Command="{Binding StartRecordingCommand}" Style="{StaticResource ToolbarButton}"
                                ToolTip="Record every tag's value changes (from simulation, clients or edits) until you stop">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C8;" Style="{StaticResource Icon}" Foreground="#D83B3B" Margin="0,0,6,0" />
                                <TextBlock Text="Record" />
                            </StackPanel>
                        </Button>
                        <Button Content="Stop &amp; save…" Command="{Binding StopRecordingCommand}" Style="{StaticResource ToolbarButton}" />
                        <TextBlock Text="every" VerticalAlignment="Center" Margin="8,0,4,4" />
                        <TextBox Text="{Binding RecordIntervalMs, UpdateSourceTrigger=LostFocus}" Width="56" MinHeight="30" Margin="0,0,4,4"
                                 IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBool}}" ToolTip="Sampling interval in milliseconds" />
                        <TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,16,4" />
                        <Button Command="{Binding ReplayCommand}" Style="{StaticResource ToolbarButton}"
                                ToolTip="Play a recording (or any time,tag,value CSV) back into the tags; their simulation pauses meanwhile">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="Replay…" />
                            </StackPanel>
                        </Button>
                        <Button Content="Stop replay" Command="{Binding StopReplayCommand}" Style="{StaticResource ToolbarButton}" />
                        <ComboBox ItemsSource="{Binding ReplaySpeeds}" SelectedItem="{Binding ReplaySpeed}" ItemStringFormat="{}{0}×" Width="80" MinHeight="30" Margin="8,0,4,4"
                                  IsEnabled="{Binding IsReplaying, Converter={StaticResource InverseBool}}" ToolTip="Replay speed" />
                        <CheckBox Content="Loop" IsChecked="{Binding ReplayLoop}" VerticalAlignment="Center" Margin="4,0,12,4"
                                  IsEnabled="{Binding IsReplaying, Converter={StaticResource InverseBool}}" />
                        <TextBlock Text="{Binding RecordReplayStatus}" VerticalAlignment="Center" Margin="0,0,0,4" FontWeight="SemiBold" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8">
                        <Run Text="Address formats: " /><Run Text="{Binding AddressHelp, Mode=OneWay}" />
                    </TextBlock>

                     <DataGrid x:Name="TagGrid" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}"
                               SelectionMode="Extended" SelectionUnit="FullRow"
                               SelectionChanged="OnTagSelectionChanged" PreviewKeyDown="OnTagGridKeyDown"
                               PreparingCellForEdit="OnPreparingCellForEdit" CellEditEnding="OnCellEditEnding" FrozenColumnCount="1">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="ContextMenuOpening" Handler="OnTagContextMenuOpening" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Tag.Name}" Width="Auto" />
                                <DataGridTextColumn Header="Address" Binding="{Binding Tag.Address}" ElementStyle="{StaticResource MonoCell}" Width="Auto" />
                                <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Tag.DataType, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static vm:EnumLists.DataTypes}" ElementStyle="{StaticResource TagGridComboBox}" EditingElementStyle="{StaticResource TagGridComboBox}" Width="Auto" />
                                <DataGridComboBoxColumn Header="Order" SelectedItemBinding="{Binding Tag.WordOrder, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static vm:EnumLists.WordOrders}" CellStyle="{StaticResource WordOrderCell}" ElementStyle="{StaticResource TagGridComboBox}" EditingElementStyle="{StaticResource TagGridComboBox}" Width="Auto" />
                            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" ElementStyle="{StaticResource MonoCell}" Width="Auto" />
                                <DataGridCheckBoxColumn Binding="{Binding Tag.Writable, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCheckBoxCell}" EditingElementStyle="{StaticResource CenteredCheckBoxCell}" Width="Auto">
                                    <DataGridCheckBoxColumn.Header>
                                        <TextBlock Text="Writeable" ToolTip="Allow external clients to write this tag. Writes to a tag that isn't writeable are rejected with the protocol's 'not writable' error." />
                                    </DataGridCheckBoxColumn.Header>
                                </DataGridCheckBoxColumn>
                                <DataGridCheckBoxColumn Header="Simulate" Binding="{Binding Tag.Simulation.Enabled, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCheckBoxCell}" EditingElementStyle="{StaticResource CenteredCheckBoxCell}" Width="Auto" />
                                <DataGridComboBoxColumn Header="Simulation" SelectedItemBinding="{Binding Tag.Simulation.Kind, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static vm:EnumLists.SimulationKinds}" ElementStyle="{StaticResource SimulationGridComboBox}" EditingElementStyle="{StaticResource SimulationGridComboBox}" Width="Auto" />
                            <DataGridTextColumn Header="Min" Binding="{Binding Tag.Simulation.Min}" CellStyle="{StaticResource RangeCell}" Width="Auto" />
                            <DataGridTextColumn Header="Max" Binding="{Binding Tag.Simulation.Max}" CellStyle="{StaticResource RangeCell}" Width="Auto" />
                            <DataGridTextColumn Header="Period (s)" Binding="{Binding Tag.Simulation.PeriodSeconds}" CellStyle="{StaticResource PeriodCell}" Width="Auto" />
                            <DataGridTextColumn Header="Step" Binding="{Binding Tag.Simulation.Step}" CellStyle="{StaticResource StepCell}" Width="Auto" />
                            <DataGridTextColumn Header="Every (ms)" Binding="{Binding Tag.Simulation.IntervalMs}" CellStyle="{StaticResource IntervalCell}" Width="Auto" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Tag.Description}" Width="Auto" />
                            <DataGridTemplateColumn Header="Status" Width="Auto" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Error}" Foreground="#D83B3B" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Error}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Scenario -->
            <TabItem Header="Scenario">
                <DockPanel Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Command="{Binding RunScenarioCommand}" Style="{StaticResource ToolbarButton}"
                                ToolTip="Run the steps below in real time against this device's tags, faults and server">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="Run scenario" />
                            </StackPanel>
                        </Button>
                        <Button Content="Stop" Command="{Binding StopScenarioCommand}" Style="{StaticResource ToolbarButton}" />
                        <ComboBox ItemsSource="{Binding ReplaySpeeds}" SelectedItem="{Binding ScenarioSpeed}" ItemStringFormat="{}{0}×" Width="80" MinHeight="30" Margin="8,0,4,4"
                                  IsEnabled="{Binding IsScenarioRunning, Converter={StaticResource InverseBool}}" ToolTip="Speed" />
                        <Button Content="Insert example" Command="{Binding InsertScenarioExampleCommand}" Style="{StaticResource ToolbarButton}" Margin="12,0,4,4"
                                ToolTip="Replace the script with an annotated example" />
                        <TextBlock Text="{Binding ScenarioStatus}" VerticalAlignment="Center" Margin="8,0,0,4" FontWeight="SemiBold" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Each line is '&lt;time&gt; &lt;action&gt;'. Tags the scenario sets or ramps pause their simulation until it ends; fault settings it changes are put back afterwards. The script is saved with the project. Steps are logged on the Traffic tab." />
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8"
                            Visibility="{Binding ScenarioError, Converter={StaticResource HasValueToVisibility}}">
                        <TextBlock Text="{Binding ScenarioError}" Foreground="#D83B3B" TextWrapping="Wrap" />
                    </Border>
                    <TextBox Text="{Binding ScenarioText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             IsReadOnly="{Binding IsScenarioRunning}" />
                </DockPanel>
            </TabItem>

            <!-- API clients (REST API) -->
            <TabItem Header="API clients" Visibility="{Binding HasApiClients, Converter={StaticResource BoolToVisibility}}">
                <DockPanel DataContext="{Binding ApiClients}" Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Command="{Binding AddClientCommand}" Style="{StaticResource ToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="Add client" />
                            </StackPanel>
                        </Button>
                        <Button Content="Remove" Command="{Binding RemoveClientCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="New secret" Command="{Binding NewSecretCommand}" Style="{StaticResource ToolbarButton}"
                                ToolTip="Generate a new random secret for the selected client" />
                        <Button Content="Revoke all tokens" Command="{Binding RevokeTokensCommand}" Style="{StaticResource ToolbarButton}" />
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,4">
                            <Run Text="{Binding ActiveTokens, Mode=OneWay}" /><Run Text=" active tokens · token endpoint " /><Run Text="{Binding TokenUrl, Mode=OneWay}" />
                        </TextBlock>
                    </WrapPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8"
                            Visibility="{Binding RequiresAuthentication, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock TextWrapping="Wrap" Text="Bearer tokens are not required right now, so any client can call the API. Turn on 'Require bearer token' on the Settings tab to enforce them." />
                    </Border>

                    <!-- Token and examples for the selected client -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Left" Content="Get token for selected client" Command="{Binding IssueTokenCommand}"
                                    Style="{DynamicResource AccentButtonStyle}" Padding="12,5" Margin="0,0,8,0" />
                            <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyTokenCommand}" Padding="12,5" Margin="8,0,0,0" />
                            <TextBox Text="{Binding TokenText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"
                                     VerticalContentAlignment="Center" ToolTip="Bearer token to put in the Authorization header" />
                        </DockPanel>
                        <TextBlock Text="{Binding TokenInfo}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyExamplesCommand}" Style="{StaticResource ToolbarButton}" />
                            <TextBlock Text="EXAMPLE REQUESTS" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox Text="{Binding Examples, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="190" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              PreparingCellForEdit="OnPreparingCellForEdit" CellEditEnding="OnCellEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CenteredCheckBoxCell}" EditingElementStyle="{StaticResource CenteredCheckBoxCell}" Width="Auto" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" MinWidth="120" />
                            <DataGridTextColumn Header="Client ID" Binding="{Binding ClientId}" ElementStyle="{StaticResource MonoCell}" Width="Auto" MinWidth="140" />
                            <DataGridTextColumn Header="Client secret" Binding="{Binding ClientSecret}" ElementStyle="{StaticResource MonoCell}" Width="Auto" MinWidth="200" />
                            <DataGridTextColumn Header="Scopes (space-separated, empty = any)" Binding="{Binding Scope}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- JSON database (REST API) -->
            <TabItem Header="Database" Visibility="{Binding HasDatabase, Converter={StaticResource BoolToVisibility}}">
                <DockPanel DataContext="{Binding Database}" Margin="0,10,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Command="{Binding ApplyCommand}" Style="{StaticResource ToolbarButton}" ToolTip="Validate the JSON and save it as the database">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="Apply changes" />
                            </StackPanel>
                        </Button>
                        <Button Content="Discard" Command="{Binding DiscardCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="Recreate…" Command="{Binding RecreateCommand}" Style="{StaticResource ToolbarButton}" Margin="12,0,4,4"
                                ToolTip="Throw away all data and start again from the sample database" />
                        <Button Content="Import…" Command="{Binding ImportCommand}" Style="{StaticResource ToolbarButton}"
                                ToolTip="Replace the database with an exported JSON file" />
                        <Button Content="Export…" Command="{Binding ExportCommand}" Style="{StaticResource ToolbarButton}"
                                ToolTip="Save the database to a JSON file, e.g. to use it on another computer" />
                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Style="{StaticResource ToolbarButton}" Margin="12,0,4,4" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8">
                        <Run Text="Each top-level property is a resource: an array is a collection (GET/POST {base}/name, GET/PUT/PATCH/DELETE {base}/name/{id}), an object is a single resource (GET/PUT/PATCH {base}/name). Changes made through the API are saved immediately to " /><Run Text="{Binding DatabasePath, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text="." />
                    </TextBlock>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8"
                            Visibility="{Binding Error, Converter={StaticResource HasValueToVisibility}}">
                        <TextBlock Text="{Binding Error}" Foreground="#D83B3B" TextWrapping="Wrap" />
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding Collections}" IsReadOnly="True" Margin="0,0,10,0" VerticalAlignment="Stretch">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Resource" Binding="{Binding Name}" ElementStyle="{StaticResource MonoCell}" Width="Auto" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="Auto" />
                                <DataGridTextColumn Header="Items" Binding="{Binding Count}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox Grid.Column="1" Text="{Binding JsonText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Traffic -->
            <TabItem Header="Traffic">
                <views:LogView DataContext="{Binding Log}" Margin="0,10,0,0" />
            </TabItem>

            <!-- Connections & statistics -->
            <TabItem Header="Connections">
                <DockPanel Margin="0,10,0,0">
                    <ItemsControl DockPanel.Dock="Top" Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Resources>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="MinWidth" Value="150" />
                                <Setter Property="Padding" Value="14,10" />
                            </Style>
                        </ItemsControl.Resources>
                        <Border><StackPanel><TextBlock Text="Active connections" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.ActiveConnections}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Requests / s" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.RequestsPerSecond}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Requests" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.Requests, StringFormat=N0}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Responses" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.Responses, StringFormat=N0}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Exceptions sent" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.Exceptions, StringFormat=N0}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Not answered" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.Dropped, StringFormat=N0}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Malformed frames" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.Malformed, StringFormat=N0}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Bytes in / out" Style="{StaticResource Caption}" />
                            <TextBlock Style="{StaticResource StatValue}"><Run Text="{Binding Stats.BytesIn, Mode=OneWay, StringFormat=N0}" /><Run Text=" / " /><Run Text="{Binding Stats.BytesOut, Mode=OneWay, StringFormat=N0}" /></TextBlock></StackPanel></Border>
                        <Border><StackPanel><TextBlock Text="Total connections" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Stats.TotalConnections, StringFormat=N0}" Style="{StaticResource StatValue}" /></StackPanel></Border>
                    </ItemsControl>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Reset counters" Command="{Binding ResetStatisticsCommand}" />
                        <TextBlock Text="CONNECTED CLIENTS" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Connections}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="Auto" />
                            <DataGridTextColumn Header="Remote endpoint" Binding="{Binding RemoteEndPoint}" Width="Auto" />
                            <DataGridTextColumn Header="Connected at" Binding="{Binding ConnectedAt}" Width="Auto" />
                            <DataGridTextColumn Header="Requests" Binding="{Binding Requests}" Width="Auto" />
                            <DataGridTextColumn Header="Last activity" Binding="{Binding LastActivity}" Width="Auto" />
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Disconnect" HorizontalAlignment="Left" Padding="10,2"
                                                Command="{Binding DataContext.DropConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Settings">
                <DockPanel Margin="0,10,0,0" MaxWidth="760" HorizontalAlignment="Left">
                    <StackPanel DockPanel.Dock="Top">
                        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8"
                                Visibility="{Binding CanEditSettings, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock Text="Stop the device to change its settings." />
                        </Border>
                        <CheckBox Content="Start this device automatically when the project is opened" IsChecked="{Binding AutoStart}" Margin="0,0,0,4" />
                    </StackPanel>
                    <controls:PropertyGrid SelectedObject="{Binding Settings}" IsEnabled="{Binding CanEditSettings}" />
                </DockPanel>
            </TabItem>

            <!-- Fault injection -->
            <TabItem Header="Fault injection">
                <DockPanel Margin="0,10,0,0" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,4"
                               Text="Make the device misbehave to test how clients handle slow responses, timeouts, error replies and dropped connections. Changes apply immediately, even while running." />
                    <controls:PropertyGrid SelectedObject="{Binding Faults}" />
                </DockPanel>
            </TabItem>
        </TabControl>

        <Border Grid.RowSpan="2" Background="#88000000" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{x:Static ApplicationCommands.NotACommand}" />
            </Border.InputBindings>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Margin="20" Padding="28,22">
                <StackPanel>
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource LoadingSpin}" />
                        </EventTrigger>
                    </StackPanel.Triggers>
                    <Grid Width="42" Height="42" HorizontalAlignment="Center">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="LoadingRotation" CenterX="21" CenterY="21" />
                        </Grid.RenderTransform>
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Loading tags…" Margin="0,12,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
