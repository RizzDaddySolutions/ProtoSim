<UserControl x:Class="ProtoSim.App.Views.LogicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProtoSim.App.ViewModels"
             xmlns:ad="https://github.com/Dirkster99/AvalonDock">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WireBrush" Color="#8C8C8C" />
        <SolidColorBrush x:Key="WireOnBrush" Color="#2EA043" />
        <SolidColorBrush x:Key="SelectBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#D83B3B" />

        <Style x:Key="LogicToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="LogicToolbarComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="PortDot" TargetType="Ellipse">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Fill" Value="{DynamicResource LogicBlockBackground}" />
            <Setter Property="Stroke" Value="{StaticResource WireBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Cursor" Value="Cross" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource WireOnBrush}" />
                    <Setter Property="Stroke" Value="{StaticResource WireOnBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource SelectBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PortValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource LogicBlockForeground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="PaletteItemTemplate" DataType="{x:Type vm:PaletteItemViewModel}">
            <Border Padding="8,5" Margin="0,1" CornerRadius="4" Cursor="Hand" Background="Transparent" ToolTip="{Binding Description}"
                    PreviewMouseLeftButtonDown="OnPaletteMouseDown" MouseMove="OnPaletteMouseMove">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="4,2">
            <MenuItem Header="_Options">
                <MenuItem x:Name="EditSelectionMenuItem" Header="Edit _selection" IsCheckable="True"
                          Checked="OnSelectionEditorToggled" Unchecked="OnSelectionEditorToggled" />
                <MenuItem Header="Run when the project _opens" IsCheckable="True" IsChecked="{Binding AutoRun}" />
                <Separator />
                <MenuItem Header="Restore _panels" Click="OnResetLayout" />
                <MenuItem Header="_Undock designer" IsCheckable="True" IsChecked="{Binding IsUndocked, Mode=OneWay}"
                          Command="{Binding ToggleDockCommand}" ToolTip="Move the designer to its own window" />
            </MenuItem>
            <MenuItem x:Name="PanelsMenu" Header="_Panels" SubmenuOpened="OnPanelsMenuOpened" />
        </Menu>

        <Grid DockPanel.Dock="Top" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" DisplayMemberPath="Name"
                          MinWidth="170" Style="{StaticResource LogicToolbarComboBox}" />
                <Button Command="{Binding AddProgramCommand}" Style="{StaticResource LogicToolbarButton}" ToolTip="Add a program">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Program" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RemoveProgramCommand}" Style="{StaticResource LogicToolbarButton}" ToolTip="Delete this program">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" />
                </Button>
                <Button Command="{Binding RunCommand}" Style="{StaticResource LogicToolbarButton}"
                        ToolTip="Run every enabled program. Tags written by Tag out blocks stop simulating while logic runs.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="#2EA043" Margin="0,0,6,0" />
                        <TextBlock Text="Run" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopCommand}" Style="{StaticResource LogicToolbarButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
                <Grid Width="260" Height="32" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextAlignment="Left" FontWeight="SemiBold"
                               Margin="0,3,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#D83B3B" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Foreground" Value="#2EA043" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Panels: drag a panel's title or tab to dock it left, top, right or bottom, or out to float it. -->
        <ad:DockingManager x:Name="Dock" AllowMixedOrientation="True">
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">
                    <ad:LayoutAnchorablePaneGroup Orientation="Vertical" DockWidth="250">
                        <ad:LayoutAnchorablePane />
                        <ad:LayoutAnchorablePane>
                            <ad:LayoutAnchorable x:Name="ProjectTagsPanel" ContentId="projectTags" Title="Project tags" CanClose="True" CanHide="True">
                                <DockPanel Margin="8">
                                    <TextBox DockPanel.Dock="Top" Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" Margin="0,0,0,4" ToolTip="Filter tags" />
                                    <TextBlock DockPanel.Dock="Top" Text="Drop = Tag in · Ctrl+drop = Tag out" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding TagItems}" ItemTemplate="{StaticResource PaletteItemTemplate}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </ad:LayoutAnchorable>
                        </ad:LayoutAnchorablePane>
                    </ad:LayoutAnchorablePaneGroup>

                    <ad:LayoutDocumentPane>
                        <ad:LayoutDocument ContentId="canvas" Title="Canvas" CanClose="False" CanFloat="False">
                <Grid>
                    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="OnCanvasWheel">
                        <Grid x:Name="Surface" Width="4000" Height="3000" AllowDrop="True" Focusable="True" FocusVisualStyle="{x:Null}"
                              Drop="OnDrop" DragOver="OnDragOver"
                              MouseLeftButtonDown="OnSurfaceDown" MouseMove="OnSurfaceMove" MouseLeftButtonUp="OnSurfaceUp" KeyDown="OnSurfaceKeyDown">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                            </Grid.LayoutTransform>
                            <Grid.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute" Opacity="0.35">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="Transparent">
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#80808080" Thickness="0.5" />
                                            </GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,20,20" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.Background>

                            <!-- Wires -->
                            <ItemsControl ItemsSource="{Binding SelectedProgram.Wires}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WireViewModel}">
                                        <Grid>
                                            <Path Data="{Binding Geometry}" Stroke="Transparent" StrokeThickness="12" Cursor="Hand"
                                                  MouseLeftButtonDown="OnWireDown" ToolTip="{Binding Description}" />
                                            <Path Data="{Binding Geometry}" StrokeThickness="2" IsHitTestVisible="False">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Stroke" Value="{StaticResource WireBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Stroke" Value="{StaticResource WireOnBrush}" />
                                                                <Setter Property="StrokeThickness" Value="3" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Stroke" Value="{StaticResource SelectBrush}" />
                                                                <Setter Property="StrokeThickness" Value="3" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Blocks -->
                            <ItemsControl ItemsSource="{Binding SelectedProgram.Blocks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BlockViewModel}">
                                        <Border Width="{Binding BlockWidth}" Height="{Binding Height}" CornerRadius="6" BorderThickness="1.5"
                                                Background="{DynamicResource LogicBlockBackground}"
                                                ToolTip="{Binding Error}" ToolTipService.IsEnabled="{Binding HasError}"
                                                ContextMenuOpening="OnBlockContextMenuOpening">
                                            <Border.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="_Edit properties" Click="OnEditBlock" />
                                                    <MenuItem Header="_Delete" Click="OnDeleteBlock" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource SelectBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.18" />
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="44" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Background="{DynamicResource LogicBlockBackground}" CornerRadius="5,5,0,0" Padding="8,4,8,4"
                                                        Cursor="SizeAll" MouseLeftButtonDown="OnBlockDown">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource LogicBlockForeground}" />
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource LogicBlockForeground}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding LiveText}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource LogicBlockForeground}" />
                                                    </Grid>
                                                </Border>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Inputs}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:PortViewModel}">
                                                            <Grid Height="22" Width="86" ToolTip="{Binding ToolTip}">
                                                                <Ellipse Style="{StaticResource PortDot}" HorizontalAlignment="Left" Margin="-6.5,0,0,0" Tag="port"
                                                                         MouseLeftButtonDown="OnPortDown" />
                                                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource LogicBlockForeground}" />
                                                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource PortValue}" Margin="5,0,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Outputs}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:PortViewModel}">
                                                            <Grid Height="22" Width="86" ToolTip="{Binding ToolTip}">
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource PortValue}" Margin="0,0,5,0" />
                                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource LogicBlockForeground}" />
                                                                </StackPanel>
                                                                <Ellipse Style="{StaticResource PortDot}" HorizontalAlignment="Right" Margin="0,0,-6.5,0" Tag="port"
                                                                         MouseLeftButtonDown="OnPortDown" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Path x:Name="TempWire" Stroke="{StaticResource SelectBrush}" StrokeThickness="2" StrokeDashArray="4 2"
                                  IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </ScrollViewer>

                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProgram.Blocks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedProgram}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Drag blocks or project tags from the panels onto the canvas, then drag from an output (right side) to an input (left side) to wire them. Tags from any device can be combined in one program." />
                    </Border>

                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,20" Style="{StaticResource Caption}"
                               Text="Ctrl + wheel to zoom · Delete removes the selection" IsHitTestVisible="False" />
                </Grid>
                        </ad:LayoutDocument>
                    </ad:LayoutDocumentPane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>

        <Popup x:Name="SelectionEditor" PlacementTarget="{Binding ElementName=Dock}" Placement="Center"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="OnSelectionEditorClosed">
            <Border Padding="14" Width="360" MaxHeight="650" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Program -->
                        <StackPanel Visibility="{Binding SelectedProgram, Converter={StaticResource HasValueToVisibility}}" Margin="0,0,0,14">
                            <TextBlock Text="PROGRAM" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding SelectedProgram.Name, UpdateSourceTrigger=LostFocus}" MinHeight="30" ToolTip="Program name" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="Enabled" IsChecked="{Binding SelectedProgram.Enabled}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Scan" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Column="2" Text="{Binding SelectedProgram.ScanMs, UpdateSourceTrigger=LostFocus}" MinHeight="30" />
                                <TextBlock Grid.Column="3" Text="ms" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding SelectedProgram.Problems}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding SelectedProgram.Problems, Converter={StaticResource HasValueToVisibility}}" />
                        </StackPanel>

                        <!-- Selected block -->
                        <ContentControl Content="{Binding SelectedProgram.SelectedBlock}" Focusable="False"
                                        Visibility="{Binding SelectedProgram.SelectedBlock, Converter={StaticResource HasValueToVisibility}, FallbackValue=Collapsed}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate DataType="{x:Type vm:BlockViewModel}">
                                    <StackPanel>
                                        <TextBlock Text="BLOCK" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Def.DisplayName}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding Def.Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10" />
                                        <TextBlock Text="Label" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=LostFocus}" MinHeight="30" Margin="0,0,0,8" ToolTip="Optional name shown on the block" />
                                        <ItemsControl ItemsSource="{Binding Params}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ParamViewModel}">
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Name}" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" MinHeight="30"
                                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                                        <CheckBox IsChecked="{Binding BoolValue}" Content="{Binding Name}"
                                                                  Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}}" />
                                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" MinHeight="30"
                                                                  Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                                                        <ComboBox ItemsSource="{Binding TagReferences}" IsEditable="True" IsTextSearchEnabled="True" MinHeight="30"
                                                                  Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                                  Visibility="{Binding IsTag, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="{Binding Help}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                                   Visibility="{Binding Help, Converter={StaticResource HasValueToVisibility}}" />
                                                        <TextBlock Text="{Binding Error}" Foreground="#D83B3B" TextWrapping="Wrap"
                                                                   Visibility="{Binding Error, Converter={StaticResource HasValueToVisibility}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Error}" Foreground="#D83B3B" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Delete block" Click="OnDeleteSelection"
                                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Selected wire -->
                        <ContentControl Content="{Binding SelectedProgram.SelectedWire}" Focusable="False"
                                        Visibility="{Binding SelectedProgram.SelectedWire, Converter={StaticResource HasValueToVisibility}, FallbackValue=Collapsed}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate DataType="{x:Type vm:WireViewModel}">
                                    <StackPanel>
                                        <TextBlock Text="WIRE" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        <Button Content="Delete wire" Click="OnDeleteSelection"
                                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Nothing selected -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProgram.Selected}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="HOW IT WORKS" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}"
                                       Text="Each program runs every scan: blocks are evaluated in wiring order, left to right through the data flow. Bool signals are 0/1 and wires carrying true turn green while running. Tag in reads any device's tag; Tag out writes one (its own simulation pauses while logic runs). Loops are allowed: a block fed by its own output sees the previous scan's value, so tanks, thermal models and control loops can be built from Integrator, Lag, PID and Hysteresis blocks. Edits apply immediately while running; timers and counters keep their state." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </DockPanel>
</UserControl>
