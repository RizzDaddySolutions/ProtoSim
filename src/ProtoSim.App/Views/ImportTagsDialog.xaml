<Window x:Class="ProtoSim.App.Views.ImportTagsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import tags" Width="500" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- A selectable card: a radio button whose content is a title and an explanation. -->
        <Style x:Key="OptionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="24,20,24,20">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" FontSize="22" Margin="0,0,10,0"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                <TextBlock Text="Import tags from CSV" Style="{StaticResource PageTitle}" FontSize="20" />
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None">
                <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ImportCount, Mode=OneWay}" /><Run Text=" tags found" />
            </TextBlock>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Import" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Padding="20,6" MinWidth="96"
                    Margin="0,0,8,0" Click="OnImport" />
            <Button Content="Cancel" IsCancel="True" Padding="20,6" MinWidth="96" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="WHAT SHOULD HAPPEN TO THE EXISTING TAGS?" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />

            <Border Style="{StaticResource OptionCard}">
                <RadioButton x:Name="AppendOption" GroupName="Mode" IsChecked="True" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Append" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0">
                            <Run Text="Keep the" /> <Run Text="{Binding ExistingCount, Mode=OneWay}" /> <Run Text="existing tags and add the imported tags after them." />
                        </TextBlock>
                    </StackPanel>
                </RadioButton>
            </Border>

            <Border Style="{StaticResource OptionCard}">
                <RadioButton x:Name="OverwriteOption" GroupName="Mode" VerticalContentAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Overwrite" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0">
                            <Run Text="Remove all" /> <Run Text="{Binding ExistingCount, Mode=OneWay}" /> <Run Text="existing tags and replace them with the imported tags." />
                        </TextBlock>
                    </StackPanel>
                </RadioButton>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
