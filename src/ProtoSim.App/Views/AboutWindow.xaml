<Window x:Class="ProtoSim.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About ProtoSim" Width="560" SizeToContent="Height" MaxHeight="720"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="24,20,24,20">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="12" Margin="0,0,16,0" VerticalAlignment="Top"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="ProtoSim" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                    <Run Text="Version" /> <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Industrial protocol simulator. Simulate devices that real SCADA, HMI and PLC clients can connect to." />
            </StackPanel>
        </Grid>

        <!-- Buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsDefault="True" IsCancel="True"
                    Style="{DynamicResource AccentButtonStyle}" Padding="20,6" MinWidth="96" />
            <TextBlock Text="MIT License" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8">
                <Run Text="SIMULATION DEVICES (" /><Run Text="{Binding ProtocolCount, Mode=OneWay}" /><Run Text=")" />
            </TextBlock>
            <Border Style="{StaticResource Card}" Padding="0">
                <ItemsControl ItemsSource="{Binding Protocols}" Margin="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="14,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,12,0"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                       Text="Add protocols by dropping plugin DLLs into the 'Plugins' folder next to the executable." />

            <StackPanel Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                <TextBlock Text="PLUGIN LOAD ERRORS" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Border Style="{StaticResource Card}" Padding="12,10" MaxHeight="160">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Errors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#D83B3B" TextWrapping="Wrap" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
