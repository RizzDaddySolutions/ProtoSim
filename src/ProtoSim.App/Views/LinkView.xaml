<UserControl x:Class="ProtoSim.App.Views.LinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ProtoSim.App.Views"
             xmlns:controls="clr-namespace:ProtoSim.App.Controls">
    <UserControl.Resources>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Foreground" Value="#D83B3B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="22" FontWeight="SemiBold"
                         BorderThickness="0" Background="Transparent" Padding="0" HorizontalAlignment="Left" MinWidth="200"
                         ToolTip="Click to rename" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                    <Run Text="Network link · " /><Run Text="{Binding ProtocolName, Mode=OneWay}" /><Run Text=" from " /><Run Text="{Binding SourceDescription, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Endpoint, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopCommand}" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: connection and timing -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CONNECTION" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="Stop the link to change connection settings." Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding CanEditSettings, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <controls:PropertyGrid SelectedObject="{Binding Settings}" IsEnabled="{Binding CanEditSettings}" LabelWidth="140" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="TIMING" Style="{StaticResource SectionHeader}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Poll every" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding Link.PollIntervalMs, UpdateSourceTrigger=LostFocus}" Width="90" />
                                <TextBlock Text="ms" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <CheckBox Content="Start the link when the project opens" IsChecked="{Binding Link.AutoStart}" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Each cycle reads every point from the source and copies it into its tag. Read-only points pause the tag's own simulation while the link runs. For Read + write points, a change made here (by a client, logic or simulation) is written back to the source instead." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- Right: status, points, traffic -->
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="110" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateToBrush}}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Link.LastMessage}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Link.LastMessage}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <Run Text="{Binding Link.LastElapsed, Mode=OneWay}" /><Run Text="  ·  cycles " /><Run Text="{Binding Link.Cycles, Mode=OneWay}" /><Run Text="  ·  failed " /><Run Text="{Binding Link.Failures, Mode=OneWay}" /><Run Text="  ·  written back " /><Run Text="{Binding Link.Writes, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="1" Margin="0,4,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="All read only" Command="{Binding ReadAllCommand}" Style="{StaticResource ToolbarButton}" />
                        <Button Content="All read + write" Command="{Binding ReadWriteAllCommand}" Style="{StaticResource ToolbarButton}"
                                ToolTip="Write changes made here back to the source (the source tags must be Writeable)" />
                        <Button Command="{Binding AddPointCommand}" Style="{StaticResource ToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="Add point" />
                            </StackPanel>
                        </Button>
                        <Button Content="Remove" Command="{Binding RemovePointCommand}" Style="{StaticResource ToolbarButton}" />
                    </StackPanel>
                    <TextBlock Text="POINTS" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                </DockPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Link.Points}" SelectedItem="{Binding SelectedPoint}"
                          CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source tag" Binding="{Binding SourceName}" Width="130" />
                        <DataGridTextColumn Header="Source address" Binding="{Binding Source, UpdateSourceTrigger=LostFocus}" ElementStyle="{StaticResource MonoCell}" Width="150" />
                        <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding DataType}" Width="90"
                                                ItemsSource="{x:Static views:LinkView.DataTypes}" />
                        <DataGridTemplateColumn Header="Direction" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Direction}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedItem="{Binding Direction, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.Directions, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Project tag (Device/Tag)" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Target}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True" IsTextSearchEnabled="True" Text="{Binding Target, UpdateSourceTrigger=LostFocus}"
                                              ItemsSource="{Binding DataContext.TagReferences, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=OneWay}" ElementStyle="{StaticResource MonoCell}" IsReadOnly="True" Width="90" />
                        <DataGridTemplateColumn Header="Status" Width="*" MinWidth="120" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" Style="{StaticResource StatusText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Margin="0,4" />

                <views:LogView Grid.Row="4" DataContext="{Binding Log}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
