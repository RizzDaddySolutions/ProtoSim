<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ProtoSim.App"
             x:Class="ProtoSim.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ApplicationWindowBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ApplicationPanelBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5F5F5F" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#D0D0D0" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#10000000" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#005FB8" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LogicBlockBackground" Color="#E8EEF6" />
                    <SolidColorBrush x:Key="LogicBlockForeground" Color="#202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ApplicationWindowBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="ApplicationPanelBackgroundBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C8C8C8" />
                    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3D3D3D" />
                    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#4A4A4A" />
                    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#383838" />
                    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#000000" />
                    <SolidColorBrush x:Key="LogicBlockBackground" Color="#454545" />
                    <SolidColorBrush x:Key="LogicBlockForeground" Color="#F5F5F5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <local:ServerStateToBrushConverter x:Key="StateToBrush" />
            <local:DirectionToBrushConverter x:Key="DirectionToBrush" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:HasValueConverter x:Key="HasValue" />
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>

            <!-- Icons are vector paths so they look the same on every OS (no Windows icon font). 16x16 grid. -->
            <StreamGeometry x:Key="IconAdd">M7 2h2v5h5v2H9v5H7V9H2V7h5z</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M3.4 2 8 6.6 12.6 2 14 3.4 9.4 8l4.6 4.6-1.4 1.4L8 9.4 3.4 14 2 12.6 6.6 8 2 3.4z</StreamGeometry>
            <StreamGeometry x:Key="IconPlay">M4 2l10 6-10 6z</StreamGeometry>
            <StreamGeometry x:Key="IconStop">M3 3h10v10H3z</StreamGeometry>
            <StreamGeometry x:Key="IconPause">M4 2h3v12H4zM9 2h3v12H9z</StreamGeometry>
            <StreamGeometry x:Key="IconLeft">M10.6 2 12 3.4 7.4 8l4.6 4.6-1.4 1.4-6-6z</StreamGeometry>
            <StreamGeometry x:Key="IconRight">M5.4 2l6 6-6 6L4 12.6 8.6 8 4 3.4z</StreamGeometry>
            <StreamGeometry x:Key="IconSearch">M6.5 1a5.5 5.5 0 0 1 4.4 8.8l4 4-1.4 1.4-4-4A5.5 5.5 0 1 1 6.5 1zm0 2a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z</StreamGeometry>
            <StreamGeometry x:Key="IconSend">M1 2l14 6-14 6 1.5-5L9 8 2.5 7z</StreamGeometry>
            <StreamGeometry x:Key="IconDelete">M6 1h4l1 1h3v2H2V2h3zM3 5h10l-1 10H4z</StreamGeometry>
            <StreamGeometry x:Key="IconSave">M2 2h9l3 3v9H2zm2 2v3h6V4zm1 6v3h6v-3z</StreamGeometry>
            <StreamGeometry x:Key="IconRecord">M8 2a6 6 0 1 1 0 12A6 6 0 0 1 8 2z</StreamGeometry>
            <StreamGeometry x:Key="IconClear">M9.5 1.5l5 5-7 7.5H4L1.5 11.5zM5 14h10v1H5z</StreamGeometry>
            <StreamGeometry x:Key="IconSync">M8 2a6 6 0 0 1 5.2 3H15l-3 4-3-4h2a4 4 0 0 0-7 1H2.2A6 6 0 0 1 8 2zM4 7l3 4H5a4 4 0 0 0 7-1h1.8A6 6 0 0 1 2.8 11H1z</StreamGeometry>
            <StreamGeometry x:Key="IconImport">M7 1h2v7l2.5-2.5L13 7l-5 5-5-5 1.5-1.5L7 8zM2 13h12v2H2z</StreamGeometry>
            <StreamGeometry x:Key="IconExport">M8 1l5 5-1.5 1.5L9 5v7H7V5L4.5 7.5 3 6zM2 13h12v2H2z</StreamGeometry>
            <StreamGeometry x:Key="IconConnect">M6 1h4v3h2v4a4 4 0 0 1-3 3.9V15H7v-3.1A4 4 0 0 1 4 8V4h2z</StreamGeometry>
            <StreamGeometry x:Key="IconDevice">M1 3h14v8H9v2h3v1.5H4V13h3v-2H1zm2 2v4h10V5z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://ProtoSim/Themes/AppStyles.axaml" />
    </Application.Styles>
</Application>
