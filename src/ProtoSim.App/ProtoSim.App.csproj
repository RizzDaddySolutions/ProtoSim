<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <RootNamespace>ProtoSim.App</RootNamespace>
    <AssemblyName>ProtoSim</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- Standalone publish: dotnet publish -r win-x64|linux-x64|linux-arm64|osx-x64|osx-arm64.
         External plugins remain separate DLLs in Plugins. -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <PublishReferencesSymbols>false</PublishReferencesSymbols>
    <AllowedReferenceRelatedFileExtensions></AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Help\index.html" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="icon.ico" />
    <EmbeddedResource Include="Help\index.html" />
    <!-- Help opens in the default browser, so it ships as a loose file next to the executable. -->
    <None Update="Help\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtoSim.Core\ProtoSim.Core.csproj" />
    <ProjectReference Include="..\ProtoSim.Protocols.ModbusTcp\ProtoSim.Protocols.ModbusTcp.csproj" />
    <ProjectReference Include="..\ProtoSim.Protocols.OpcUa\ProtoSim.Protocols.OpcUa.csproj" />
    <ProjectReference Include="..\ProtoSim.Protocols.Mqtt\ProtoSim.Protocols.Mqtt.csproj" />
    <ProjectReference Include="..\ProtoSim.Protocols.Dnp3\ProtoSim.Protocols.Dnp3.csproj" />
    <ProjectReference Include="..\ProtoSim.Protocols.Rest\ProtoSim.Protocols.Rest.csproj" />
    <ProjectReference Include="..\ProtoSim.Protocols.SparkplugB\ProtoSim.Protocols.SparkplugB.csproj" />
    <ProjectReference Include="..\ProtoSim.Protocols.Bacnet\ProtoSim.Protocols.Bacnet.csproj" />
    <ProjectReference Include="..\ProtoSim.Protocols.Snmp\ProtoSim.Protocols.Snmp.csproj" />
    <ProjectReference Include="..\ProtoSim.Protocols.MTConnect\ProtoSim.Protocols.MTConnect.csproj" />
    <ProjectReference Include="..\ProtoSim.Protocols.Script\ProtoSim.Protocols.Script.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- Newer than the version Avalonia pulls in, which has a known vulnerability. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
    <PackageReference Include="System.DirectoryServices" Version="11.0.0" />
  </ItemGroup>

  <Target Name="RemovePublishSymbols" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
  </Target>

</Project>
